+    def _block_bound(self, e: int) -> float:
+        """端 e から未訪問の駅だけを通って伸ばせる距離の上界（ブロックカット木版、しっぽは含まない）。
+
+        未訪問の駅と e からなるグラフを関節点で 2 連結成分（ブロック）に分ける。
+        e から出る単純な経路は、関節点を越えて別のブロックに入ったら元のブロックに戻れない
+        （関節点を 2 度通ることになる）。したがって経路が通るブロックは、ブロックカット木の
+        根 e からの 1 本の道に沿ったものだけになる。
+        各ブロック B（入口の駅 c）の中で使う距離は「c は B 内の辺 1 本、それ以外の駅は 2 本」で
+        抑えられるので、その値を木の上で「入口から下る道のうち最大のもの」として足し合わせる。
+        """
+        visited, jadj = self.visited, self.jadj
+        disc = {e: 0}
+        low = {e: 0}
+        t = 1
+        estack: List[Tuple[int, int, float]] = []
+        value: dict = {}  # value[v]: v から子孫のブロックへ下りて伸ばせる距離の上界
+        stack = [[e, -1, 0]]  # [駅, 来たチェーン ID, 次に調べる隣接リストの位置]
+        while stack:
+            fr = stack[-1]
+            v, pe, i = fr
+            nbrs = jadj[v]
+            if i < len(nbrs):
+                fr[2] = i + 1
+                w, cid, j = nbrs[i]
+                if cid == pe or (visited[j] and j != e):
+                    continue
+                if j not in disc:
+                    disc[j] = low[j] = t
+                    t += 1
+                    estack.append((v, j, w))
+                    stack.append([j, cid, 0])
+                elif disc[j] < disc[v]:  # 祖先への後退辺（平行なチェーンも含む）
+                    estack.append((v, j, w))
+                    if disc[j] < low[v]:
+                        low[v] = disc[j]
+                continue
+            stack.pop()
+            if not stack:
+                break
+            u = stack[-1][0]
+            if low[v] < low[u]:
+                low[u] = low[v]
+            if low[v] >= disc[u]:
+                # u を入口とするブロックを取り出す
+                top: dict = {}
+                while True:
+                    a, b, w = estack.pop()
+                    for x in (a, b):
+                        p = top.get(x)
+                        if p is None:
+                            top[x] = [w, 0.0]
+                        elif w > p[0]:
+                            p[1] = p[0]
+                            p[0] = w
+                        elif w > p[1]:
+                            p[1] = w
+                    if a == u and b == v:
+                        break
+                inside = top[u][0]
+                best_exit = 0.0
+                for x, (w1, w2) in top.items():
+                    if x == u:
+                        continue
+                    inside += w1 + w2
+                    vx = value.get(x, 0.0)
+                    if vx > best_exit:
+                        best_exit = vx
+                cand = inside / 2.0 + best_exit
+                if cand > value.get(u, 0.0):
+                    value[u] = cand
+        return value.get(e, 0.0)
+
     def _can_improve(self, upper: float) -> bool:
